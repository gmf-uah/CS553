        "@types/bcryptjs": "^2.4.3",
        "@types/jsonwebtoken": "^9.0.2",
		"@types/node": "^25.5.0",
		"@types/pg": "^8.18.0",
		"@types/supertest": "^6.0.3",
		"supertest": "^7.0.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
        "bcryptjs": "^2.4.3",
