{
	"name": "cs453-project-template",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only apps/api/src/server.ts",
		"start": "ts-node --transpile-only apps/api/src/server.ts",
		"build": "tsc -p tsconfig.json",
		"db:start": "docker compose up -d",
		"db:stop": "docker compose down",
		"db:reset": "docker compose down -v",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gmf-uah/CS553.git"
	},
	"private": true,
	"devDependencies": {
